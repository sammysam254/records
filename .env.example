# ========================================================
# NETLIFY & LOCAL ENVIRONMENT VARIABLES TEMPLATE
# Copy and paste these into Netlify Site Settings -> Environment Variables
# ========================================================

# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Upstash Redis
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
VITE_UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
VITE_UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
UPSTASH_REDIS_URL=your_upstash_redis_connection_url

# TextSMS Kenya
TEXTSMS_API_KEY=your_textsms_api_key
VITE_TEXTSMS_API_KEY=your_textsms_api_key
TEXTSMS_PARTNER_ID=
VITE_TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=your_shortcode
VITE_TEXTSMS_SHORTCODE=your_shortcode

# Paystack Transfers API (M-Pesa Kenya Mobile Money)
# Add PAYSTACK_SECRET_KEY to Netlify Site Settings -> Environment Variables
PAYSTACK_SECRET_KEY=your_paystack_secret_key
VITE_PAYSTACK_SECRET_KEY=your_paystack_secret_key
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key


